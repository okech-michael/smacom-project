# SMACOM Vercel Production Environment
# Use these with Vercel environment variables

# ============================================
# Environment
# ============================================
ENVIRONMENT=production
DEBUG=false

# ============================================
# Frontend URLs
# ============================================
FRONTEND_URL=https://your-project.vercel.app
VITE_API_URL=https://your-project.vercel.app

# ============================================
# Security
# ============================================
JWT_SECRET=change-to-strong-random-string-in-vercel-dashboard
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# ============================================
# Database - Supabase
# ============================================
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
SUPABASE_ANON_KEY=your-production-anon-key

# ============================================
# Payment Services (Update with production credentials)
# ============================================
# M-Pesa
MPESA_CONSUMER_KEY=your-production-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-production-mpesa-consumer-secret
MPESA_SHORTCODE=your-production-mpesa-shortcode
MPESA_PASSKEY=your-production-mpesa-passkey
MPESA_CALLBACK_URL=https://your-project.vercel.app/api/v1/payments/mpesa/callback

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your-production-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-production-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_HASH=your-production-webhook-hash

# ============================================
# Email - SendGrid
# ============================================
SENDGRID_API_KEY=your-production-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smacom.co.ke

# ============================================
# Port (Auto-assigned by Vercel)
# ============================================
PORT=8000
