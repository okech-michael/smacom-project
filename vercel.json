{
  "version": 2,
  "buildCommand": "cd green-cycle-hub && npm install --legacy-peer-deps && npm run build",
  "installCommand": "pip install -r requirements.txt && cd green-cycle-hub && npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "green-cycle-hub/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
