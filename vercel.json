{
  "version": 2,
  "installCommand": "pip install -r requirements.txt && cd green-cycle-hub && npm install --legacy-peer-deps",
  "buildCommand": "cd green-cycle-hub && npm run build",
  "builds": [
    {
      "src": "green-cycle-hub/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.12",
        "requirementsFile": "requirements.txt",
        "maxLambdaSize": "250mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONPATH": "/var/task",
    "ENVIRONMENT": "production"
  }
}
