# SMACOM VERCEL DEPLOYMENT
# Frontend + Backend on Vercel (IoT/MQTT disabled for now)

# ============================================
# Frontend Configuration
# ============================================
VITE_API_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_ENVIRONMENT=production

# ============================================
# Backend Configuration (Vercel)
# ============================================
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://your-smacom-domain.com

# ============================================
# Authentication & Security (REQUIRED)
# ============================================
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Supabase Database (REQUIRED)
# ============================================
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Payment Gateways
# ============================================
# M-Pesa
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-smacom-domain.com/api/v1/payments/mpesa/callback

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# ============================================
# Email Service
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smacom.io

# ============================================
# IoT/MQTT (DISABLED - Will be moved to Railway)
# ============================================
# MQTT_BROKER_HOST=disabled-on-vercel
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=your-mqtt-username
# MQTT_PASSWORD=your-mqtt-password

# ============================================
# Firebase (Optional)
# ============================================
# FIREBASE_CREDENTIALS_JSON=./firebase-credentials.json

# ============================================
# Application
# ============================================
FRONTEND_URL=http://localhost:3000
PORT=8000

