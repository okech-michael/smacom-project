# Environment variables template for backend on Railway/Production
# Copy this to a `.env` file in the backend directory and fill in the values

# ============================================
# Environment Setup
# ============================================
ENVIRONMENT=production
DEBUG=False
FASTAPI_ENV=production

# ============================================
# Security
# ============================================
JWT_SECRET=generate-a-secure-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# Frontend URLs (for CORS)
# ============================================
# Add your Vercel frontend URL here
FRONTEND_URL=www.smacom.co.ke
ALLOWED_ORIGINS=https://www.smacom.co.ke,https://yourdomain.com,http://localhost:5173,http://localhost:3000

# Add Vercel-specific URLs (optional, if using custom configuration)
VERCEL_FRONTEND_URLS=  www.smacom.co.ke,smacom.co.ke

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=h
SUPABASE_API_KEY=your-supabase-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# MQTT Configuration
# ============================================
# For HiveMQ Cloud (recommended for production)
MQTT_BROKER_URL=your-hivemq-broker-url.hivemq.cloud
MQTT_BROKER_HOST=your-hivemq-broker-url.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=True

# ============================================
# Payment Gateways
# ============================================
# M-Pesa (Daraja API)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-backend-url.com/api/v1/payments/mpesa/callback

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# ============================================
# Email Service (SendGrid)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smacom.co.ke

# ============================================
# External APIs
# ============================================
# OpenAI (for AI recommendations)
OPEN_AI_API_KEY=your-openai-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Firebase Configuration
# ============================================
FIREBASE_CREDENTIALS_JSON=./firebase-credentials.json

# ============================================
# Marketplace Configuration
# ============================================
COMMISSION_PERCENTAGE=10
PLATFORM_FEE=0.02

# ============================================
# Database
# ============================================
# If using PostgreSQL (optional)
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# Application Configuration
# ============================================
PORT=8000
SECRET_KEY=your-secret-key-here
