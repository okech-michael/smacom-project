# ============================================
# SMACOM Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Environment
# ============================================
ENVIRONMENT=production
DEBUG=false

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=https://www.smacom.co.ke

# ============================================
# Database - Supabase (REQUIRED)
# ============================================
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Security - JWT (REQUIRED)
# ============================================
JWT_SECRET=generate-secure-key-with-openssl-rand-base64-32

# ============================================
# Authentication - Google OAuth (REQUIRED)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Payment Services (Optional)
# ============================================
# M-Pesa
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://www.smacom.co.ke/api/v1/payments/mpesa/callback

# Flutterwave
FLUTTERWAVE_SECRET_KEY=your-flutterwave-key
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# ============================================
# Email Service - SendGrid (Optional)
# ============================================
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@smacom.co.ke

# ============================================
# Firebase (Optional)
# ============================================
FIREBASE_CREDENTIALS_JSON={}

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=["https://www.smacom.co.ke","https://smacom.co.ke"]

# ============================================
# IoT/MQTT (Disabled on Vercel)
# ============================================
MQTT_ENABLED=false
MQTT_BROKER_HOST=disabled
MQTT_BROKER_PORT=1883

