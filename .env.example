# Environment Configuration
DEBUG=false
ENVIRONMENT=production
FRONTEND_URL=https://your-railway-app.up.railway.app
ALLOWED_ORIGINS=https://your-railway-app.up.railway.app

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# MQTT Configuration (Railway will manage this)
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# M-Pesa Payment Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-railway-app.up.railway.app/api/v1/payments/mpesa/callback

# Flutterwave Payment Configuration
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash

# SendGrid Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@smacom.co.ke

# Firebase Configuration (as JSON string)
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# JWT Secret (change this in production!)
JWT_SECRET=your_secure_jwt_secret_key_here
