# ============================================
# SMACOM Configuration Reference
# ============================================
# For full environment configuration, see: green-cycle-hub/backend/.env.example
# 
# On Vercel: Set these variables in Vercel Dashboard → Settings → Environment Variables
# On Local: Copy green-cycle-hub/backend/.env.example to green-cycle-hub/backend/.env

# ============================================
# REQUIRED - Authentication & Security
# ============================================
JWT_SECRET=your-secure-jwt-secret-key-32-chars-min
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# REQUIRED - Database
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# OPTIONAL - Payments
# ============================================
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
FLUTTERWAVE_SECRET_KEY=your-flutterwave-key
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# ============================================
# OPTIONAL - Email
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@smacom.co.ke

